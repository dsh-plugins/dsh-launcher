{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the launcher windows (main + TUI terminal + frameless early-loading / update-notice windows)",
  "windows": ["main", "tui-*", "early-loading-*", "update-notice"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:webview:default",
    "core:app:default",
    "core:image:default",
    "dialog:default",
    "autostart:default"
  ]
}